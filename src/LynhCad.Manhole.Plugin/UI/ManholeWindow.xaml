<Window x:Class="LynhCad.Manhole.Plugin.UI.ManholeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LynhCadToolsBox - Manhole Detail (AU)"
        Width="1100" Height="660" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" FontSize="12">

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,3,8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,3,12,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="Gray" />
        </Style>
        <Style x:Key="Num" TargetType="TextBox">
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Width" Value="80" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="Dia" TargetType="ComboBox">
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Width" Value="60" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,10,4,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- Nút lệnh -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Load JSON..." Padding="10,3" Margin="0,0,6,0" Click="OnLoadJson" />
                <Button Content="Save JSON..." Padding="10,3" Margin="0,0,6,0" Click="OnSaveJson" />
                <Button Content="Sample: Rectangular" Padding="10,3" Margin="0,0,6,0" Click="OnSampleRect" />
                <Button Content="Sample: Circular precast" Padding="10,3" Margin="0,0,6,0" Click="OnSampleCirc" />
                <Button Content="Sample: Circular cast" Padding="10,3" Click="OnSampleCircCast" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnDraw" Content="Draw" Width="90" Padding="10,3" Margin="0,0,6,0" IsDefault="True" Click="OnDraw" />
                <Button Content="Cancel" Width="90" Padding="10,3" IsCancel="True" />
            </StackPanel>
        </Grid>

        <!-- Trạng thái kiểm tra -->
        <TextBlock x:Name="txtStatus" DockPanel.Dock="Bottom" Margin="4,8,4,0" TextWrapping="Wrap" Foreground="DarkRed" />

        <TabControl x:Name="tabs" SelectionChanged="OnTabChanged">

            <!-- ===================== CHUNG ===================== -->
            <TabItem Header="General">
                <!-- thông số | thanh kéo | sơ đồ kích thước (rê chuột lên kích thước để biết ô nhập tương ứng) -->
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="340" MinWidth="200" />
                    </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel LostFocus="OnFieldChanged" Selector.SelectionChanged="OnFieldSelectionChanged"
                                ToggleButton.Checked="OnFieldChanged" ToggleButton.Unchecked="OnFieldChanged"
                                GotKeyboardFocus="OnFieldFocus">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Manhole ID" />
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Num}" TextAlignment="Left" Text="{Binding Id}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Lbl}" Text="Type" />
                            <ComboBox x:Name="cbType" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" Width="160" Margin="2,3"
                                      HorizontalAlignment="Left" SelectedItem="{Binding Type}" SelectionChanged="OnTypeChanged" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Drawing scale  1 :" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding Scale}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Lbl}" Text="Concrete grade" />
                            <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource Num}" TextAlignment="Left" Text="{Binding ConcreteGrade}" />

                            <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="4,6" Content="Roof slab reinforcement plan" IsChecked="{Binding DrawRoofPlan}" />
                            <CheckBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Margin="4,6" Content="Bar schedule + notes" IsChecked="{Binding DrawSchedule}" />
                        </Grid>

                        <!-- Hố chữ nhật -->
                        <GroupBox x:Name="grpRect" Header="Rectangular cast in-situ" Margin="0,8,0,0" Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Internal length (X)" />
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding InternalLength}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Lbl}" Text="Internal width (Y)" />
                                <TextBox Grid.Row="0" Grid.Column="4" Style="{StaticResource Num}" Text="{Binding InternalWidth}" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Wall thickness" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding WallThickness}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="mm" />
                            </Grid>
                        </GroupBox>

                        <!-- Hố tròn (đúc sẵn / đổ tại chỗ): tiêu đề và ô chiều dày tường đổi theo loại hố -->
                        <GroupBox x:Name="grpCirc" Header="Circular" Margin="0,8,0,0" Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Internal diameter" />
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding InternalDiameter}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock x:Name="lblPrecastWall" Grid.Row="0" Grid.Column="3" Style="{StaticResource Lbl}" Text="Precast wall" />
                                <TextBox x:Name="txtPrecastWall" Grid.Row="0" Grid.Column="4" Style="{StaticResource Num}" Text="{Binding PrecastWallThickness}" />
                                <TextBlock x:Name="lblCastWall" Grid.Row="0" Grid.Column="3" Style="{StaticResource Lbl}" Text="Wall thickness" />
                                <TextBox x:Name="txtCastWall" Grid.Row="0" Grid.Column="4" Style="{StaticResource Num}" Text="{Binding WallThickness}" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock x:Name="lblRing" Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Ring height (joints)" />
                                <TextBox x:Name="txtRing" Grid.Row="1" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding RingHeight}" />
                                <TextBlock x:Name="unitRing" Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Lbl}" Text="Access opening Ø" />
                                <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource Num}" Text="{Binding OpeningDiameter}" />
                                <TextBlock Grid.Row="1" Grid.Column="5" Style="{StaticResource Unit}" Text="mm" />
                            </Grid>
                        </GroupBox>

                        <!-- Bản & lỗ thăm -->
                        <GroupBox Header="Slabs &amp; access opening" Margin="0,8,0,0" Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Base thickness" />
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding BaseThickness}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Lbl}" Text="Base projection" />
                                <TextBox Grid.Row="0" Grid.Column="4" Style="{StaticResource Num}" Text="{Binding BaseProjection}" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Style="{StaticResource Unit}" Text="mm" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Roof thickness" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding RoofThickness}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Lbl}" Text="Roof projection" />
                                <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource Num}" Text="{Binding RoofProjection}" />
                                <TextBlock Grid.Row="1" Grid.Column="5" Style="{StaticResource Unit}" Text="mm" />

                                <TextBlock x:Name="lblOpenX" Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="Opening size X" />
                                <TextBox x:Name="txtOpenX" Grid.Row="2" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding OpeningX}" />
                                <TextBlock x:Name="unitOpenX" Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock x:Name="lblOpenY" Grid.Row="2" Grid.Column="3" Style="{StaticResource Lbl}" Text="Opening size Y" />
                                <TextBox x:Name="txtOpenY" Grid.Row="2" Grid.Column="4" Style="{StaticResource Num}" Text="{Binding OpeningY}" />
                                <TextBlock x:Name="unitOpenY" Grid.Row="2" Grid.Column="5" Style="{StaticResource Unit}" Text="mm" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="Opening offset X" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding OpeningOffsetX}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource Lbl}" Text="Opening offset Y" />
                                <TextBox Grid.Row="3" Grid.Column="4" Style="{StaticResource Num}" Text="{Binding OpeningOffsetY}" />
                                <TextBlock Grid.Row="3" Grid.Column="5" Style="{StaticResource Unit}" Text="mm" />
                            </Grid>
                        </GroupBox>

                        <!-- Cao độ -->
                        <GroupBox Header="Levels (m AHD)" Margin="0,8,0,0" Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Cover level (CL)" />
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding CoverLevel, StringFormat=0.000}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" Text="m" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Lbl}" Text="CL to top of roof" ToolTip="Cover, frame and adjustment rings" />
                                <TextBox Grid.Row="0" Grid.Column="4" Style="{StaticResource Num}" Text="{Binding CoverAllowance}" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Sump below pipes" ToolTip="Lowest pipe outside bottom to top of base slab" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding SumpDepth}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Lbl}" Text="Pipe clearance" ToolTip="Gap around pipe in wall penetration, each side" />
                                <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource Num}" Text="{Binding PipeClearance}" />
                                <TextBlock Grid.Row="1" Grid.Column="5" Style="{StaticResource Unit}" Text="mm" />
                            </Grid>
                        </GroupBox>

                        <!-- Bậc thang -->
                        <GroupBox Header="Step irons" Margin="0,8,0,0" Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="4,6" Content="Draw step irons" IsChecked="{Binding StepIrons}" />
                                <CheckBox Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Margin="4,6" Content="Auto position (near opening, clear of pipes)" IsChecked="{Binding StepAuto}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Vertical spacing" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding StepSpacing}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Lbl}" Text="Angle (when not auto)" ToolTip="Direction from manhole centre to the wall with the steps: 0° = +X (east), counter-clockwise" />
                                <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource Num}" Text="{Binding StepAngle}" />
                                <TextBlock Grid.Row="1" Grid.Column="5" Style="{StaticResource Unit}" Text="°" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="Width" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding StepWidth}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Lbl}" Text="Projection from wall" />
                                <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource Num}" Text="{Binding StepProjection}" />
                                <TextBlock Grid.Row="2" Grid.Column="5" Style="{StaticResource Unit}" Text="mm" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="Top step below roof" ToolTip="From underside of roof slab down to the top step" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding StepTopGap}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}" Text="mm" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource Lbl}" Text="Bottom step above benching" ToolTip="Minimum height of the lowest step above the benching (top of outlet pipe)" />
                                <TextBox Grid.Row="3" Grid.Column="4" Style="{StaticResource Num}" Text="{Binding StepBottomClear}" />
                                <TextBlock Grid.Row="3" Grid.Column="5" Style="{StaticResource Unit}" Text="mm" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Margin="2,0,0,4" FontWeight="SemiBold" Text="Preview (plan + section) - the focused field is highlighted; hover a dimension for its field" />
                    <TextBlock x:Name="txtGeneralPreviewInfo" DockPanel.Dock="Bottom" Margin="2,4,0,0" TextWrapping="Wrap" Foreground="DarkRed" />
                    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White" ClipToBounds="True">
                        <Canvas x:Name="cvGeneralPreview" SizeChanged="OnPreviewSizeChanged" />
                    </Border>
                </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===================== THÉP ===================== -->
            <TabItem Header="Reinforcement">
                <!-- thông số thép | thanh kéo | xem trước bố trí thép trên mặt cắt A-A -->
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="340" MinWidth="200" />
                    </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <Grid LostFocus="OnFieldChanged" Selector.SelectionChanged="OnFieldSelectionChanged"
                          ToggleButton.Checked="OnFieldChanged" ToggleButton.Unchecked="OnFieldChanged"
                          GotKeyboardFocus="OnFieldFocus">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Style="{StaticResource Head}" Text="Bars: N (D500N, AS/NZS 4671) — size / spacing (mm)" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Wall vertical" />
                        <ComboBox x:Name="cbWallV" Grid.Row="1" Grid.Column="1" Style="{StaticResource Dia}" SelectedItem="{Binding WallVertical.Diameter}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="@" />
                        <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource Num}" Text="{Binding WallVertical.Spacing}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="Wall horizontal" />
                        <ComboBox x:Name="cbWallH" Grid.Row="2" Grid.Column="1" Style="{StaticResource Dia}" SelectedItem="{Binding WallHorizontal.Diameter}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" Text="@" />
                        <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource Num}" Text="{Binding WallHorizontal.Spacing}" />

                        <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Margin="4,4" IsChecked="{Binding WallSingleLayer}"
                                  Content="Walls: single central layer (CENTRAL) instead of two layers each face (EF)" />
                        <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Margin="4,4" IsChecked="{Binding WallHorizontalInside}"
                                  Content="Wall horizontal bars inside the vertical bars (default: horizontal bars are the outer layer)" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Lbl}" Text="Base bottom (EW)" />
                        <ComboBox x:Name="cbBaseB" Grid.Row="5" Grid.Column="1" Style="{StaticResource Dia}" SelectedItem="{Binding BaseBottom.Diameter}" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Unit}" Text="@" />
                        <TextBox Grid.Row="5" Grid.Column="3" Style="{StaticResource Num}" Text="{Binding BaseBottom.Spacing}" />

                        <CheckBox Grid.Row="6" Grid.Column="0" Margin="4,6" Content="Base top mat (EW)" IsChecked="{Binding BaseTopMat}" />
                        <ComboBox x:Name="cbBaseT" Grid.Row="6" Grid.Column="1" Style="{StaticResource Dia}" SelectedItem="{Binding BaseTop.Diameter}" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Unit}" Text="@" />
                        <TextBox Grid.Row="6" Grid.Column="3" Style="{StaticResource Num}" Text="{Binding BaseTop.Spacing}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource Lbl}" Text="Roof bottom (EW)" />
                        <ComboBox x:Name="cbRoofB" Grid.Row="7" Grid.Column="1" Style="{StaticResource Dia}" SelectedItem="{Binding RoofBottom.Diameter}" />
                        <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Unit}" Text="@" />
                        <TextBox Grid.Row="7" Grid.Column="3" Style="{StaticResource Num}" Text="{Binding RoofBottom.Spacing}" />

                        <CheckBox Grid.Row="8" Grid.Column="0" Margin="4,6" Content="Roof top mat (EW)" IsChecked="{Binding RoofTopMat}" />
                        <ComboBox x:Name="cbRoofT" Grid.Row="8" Grid.Column="1" Style="{StaticResource Dia}" SelectedItem="{Binding RoofTop.Diameter}" />
                        <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource Unit}" Text="@" />
                        <TextBox Grid.Row="8" Grid.Column="3" Style="{StaticResource Num}" Text="{Binding RoofTop.Spacing}" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource Lbl}" Text="Trimmers (size / no. each side)" />
                        <ComboBox x:Name="cbTrim" Grid.Row="9" Grid.Column="1" Style="{StaticResource Dia}" SelectedItem="{Binding TrimmerDiameter}" />
                        <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource Unit}" Text="x" />
                        <TextBox Grid.Row="9" Grid.Column="3" Style="{StaticResource Num}" Text="{Binding TrimmerCount}" />

                        <TextBlock Grid.Row="10" Grid.ColumnSpan="5" Style="{StaticResource Head}" Text="Detailing" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource Lbl}" Text="Cover" />
                        <TextBox Grid.Row="11" Grid.Column="3" Style="{StaticResource Num}" Text="{Binding Cover}" />
                        <TextBlock Grid.Row="11" Grid.Column="4" Style="{StaticResource Unit}" Text="mm" />

                        <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource Lbl}" Text="Lap length factor (× d)" />
                        <TextBox Grid.Row="12" Grid.Column="3" Style="{StaticResource Num}" Text="{Binding LapFactor}" />
                        <TextBlock Grid.Row="12" Grid.Column="4" Style="{StaticResource Unit}" Text="d" />

                        <TextBlock Grid.Row="13" Grid.Column="0" Style="{StaticResource Lbl}" Text="Wall vertical bar leg into base" />
                        <TextBox Grid.Row="13" Grid.Column="3" Style="{StaticResource Num}" Text="{Binding VerticalBarLeg}" />
                        <TextBlock Grid.Row="13" Grid.Column="4" Style="{StaticResource Unit}" Text="mm" />
                    </Grid>
                </ScrollViewer>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Margin="2,0,0,4" FontWeight="SemiBold" Text="Preview (plan + section A-A) - the focused field's bars are highlighted" />
                    <TextBlock x:Name="txtRebarPreviewInfo" DockPanel.Dock="Bottom" Margin="2,4,0,0" TextWrapping="Wrap" Foreground="DarkRed" />
                    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White" ClipToBounds="True">
                        <Canvas x:Name="cvRebarPreview" SizeChanged="OnPreviewSizeChanged" />
                    </Border>
                </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===================== ỐNG ===================== -->
            <TabItem Header="Pipes">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="+ Add pipe" Padding="8,2" Margin="0,0,6,0" Click="OnAddPipe" />
                        <Button Content="− Remove selected" Padding="8,2" Click="OnRemovePipe" />
                        <TextBlock x:Name="txtPipeHint" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- bảng ống | thanh kéo | xem trước vị trí ống trên mặt bằng -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="340" MinWidth="200" />
                        </Grid.ColumnDefinitions>
                    <DataGrid x:Name="gridPipes" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Extended" RowHeaderWidth="0"
                              CellEditEnding="OnPipeCellEditEnding" CurrentCellChanged="OnPipeCurrentCellChanged"
                              PreparingCellForEdit="OnPipePreparingCellForEdit">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mark" Width="60" Binding="{Binding Mark}" />
                            <DataGridComboBoxColumn x:Name="colRole" Header="Role" Width="80" SelectedItemBinding="{Binding Role}" />
                            <!-- DN / OD / vật liệu: chọn từ danh sách (PipeCatalog) hoặc gõ giá trị khác; đổi DN / vật liệu thì OD tự điền -->
                            <DataGridTemplateColumn Header="DN (mm)" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding NominalDiameter}" Margin="3,0" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" ItemsSource="{Binding SizeOptions}"
                                                  Text="{Binding NominalDiameter, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="OD (mm)" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding OutsideDiameter}" Margin="3,0" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" ItemsSource="{Binding OutsideDiameterOptions}"
                                                  Text="{Binding OutsideDiameter, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Material" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Material}" Margin="3,0" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" ItemsSource="{Binding MaterialOptions}"
                                                  Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="IL (m)" Width="80" Binding="{Binding InvertLevel, StringFormat=0.000}" />
                            <DataGridTextColumn x:Name="colAngle" Header="Angle (°)" Width="70" Binding="{Binding AngleDeg}" />
                            <DataGridComboBoxColumn x:Name="colWall" Header="Wall" Width="80" SelectedItemBinding="{Binding Wall}" />
                            <DataGridTextColumn x:Name="colOffset" Header="Offset (mm)" Width="85" Binding="{Binding Offset}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Margin="2,0,0,4" FontWeight="SemiBold"
                                   Text="Preview (plan) - outlet blue, clashes red" />
                        <TextBlock x:Name="txtPreviewInfo" DockPanel.Dock="Bottom" Margin="2,4,0,0" TextWrapping="Wrap" Foreground="DarkRed" />
                        <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White" ClipToBounds="True">
                            <Canvas x:Name="cvPreview" SizeChanged="OnPreviewSizeChanged" />
                        </Border>
                    </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
