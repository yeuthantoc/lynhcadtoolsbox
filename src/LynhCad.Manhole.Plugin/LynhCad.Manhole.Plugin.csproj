<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plugin AutoCAD 2021-2024 (.NET Framework 4.8, x64).
    Tham chiếu API:
      - Mặc định: NuGet "AutoCAD.NET" 24.0.0 (API của AutoCAD 2021, chạy được trên 2021-2024).
        Build riêng cho một bản: -p:AcadNetVersion=24.2.0 (2023), 24.1.51000 (2022), 24.3.0 (2024).
      - Không có mạng / bị chặn NuGet: build với  -p:AcadDir="C:\Program Files\Autodesk\AutoCAD 2024"
        để tham chiếu thẳng accoremgd.dll, acdbmgd.dll, acmgd.dll trong thư mục cài AutoCAD.
    Kết quả: bin\Release\net48\LynhCad.Manhole.dll (+ LynhCad.Manhole.Core.dll). AutoCAD KHÔNG nạp DLL này trực tiếp mà qua LynhCad.Loader.dll.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>LynhCad.Manhole</AssemblyName>
    <RootNamespace>LynhCad.Manhole.Plugin</RootNamespace>
    <Version>0.1.0</Version>
    <Company>LynhCadToolsBox</Company>
    <Product>LynhCadToolsBox - Manhole Detail</Product>
    <GenerateResourceUsePreserializedResources>false</GenerateResourceUsePreserializedResources>
    <AcadNetVersion Condition="'$(AcadNetVersion)' == ''">24.0.0</AcadNetVersion>
    <!--
      Mỗi lần build một AssemblyVersion khác (0.1.yyDDD.giây/2). Bắt buộc cho LCT_RELOAD:
      WPF tìm XAML theo "tên;phiên bản" và cache theo đó, trùng phiên bản sẽ mở hộp thoại của bản cũ.
    -->
    <BuildDay>$([System.DateTime]::UtcNow.ToString("yy"))$([System.DateTime]::UtcNow.DayOfYear.ToString("000"))</BuildDay>
    <BuildRev>$([System.Convert]::ToInt32($([MSBuild]::Divide($([System.DateTime]::UtcNow.TimeOfDay.TotalSeconds), 2))))</BuildRev>
    <AssemblyVersion>0.1.$(BuildDay).$(BuildRev)</AssemblyVersion>
    <FileVersion>0.1.$(BuildDay).$(BuildRev)</FileVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(AcadDir)' == ''">
    <PackageReference Include="AutoCAD.NET" Version="$(AcadNetVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(AcadDir)' != ''">
    <Reference Include="accoremgd"><HintPath>$(AcadDir)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acdbmgd"><HintPath>$(AcadDir)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acmgd"><HintPath>$(AcadDir)\acmgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LynhCad.Manhole.Core\LynhCad.Manhole.Core.csproj" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
